# ──────────────────────────────────────────────────────────────
# JARVIS — Configuração de ambiente (Fase 1: Core + Chat)
# Copie este arquivo para ".env" e preencha os valores.
# ──────────────────────────────────────────────────────────────

# --- Servidor ---
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Provedor de IA ---
# "ollama"    = 100% grátis e local, sem chave de API (recomendado pra
#               começar sem gastar nada). Requer o Ollama instalado e os
#               modelos baixados — veja README.md, seção
#               "Rodando 100% grátis (Ollama)".
# "anthropic" = API paga da Anthropic, melhor qualidade/confiabilidade.
LLM_PROVIDER=ollama

# Usado somente quando LLM_PROVIDER=anthropic. Obtenha em
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usado somente quando LLM_PROVIDER=ollama. Endereço do serviço local do
# Ollama (o padrão já funciona se você instalou normalmente).
OLLAMA_BASE_URL=http://localhost:11434

# Modelos usados pelo ModelRouter (packages/ai) para cada nível de tarefa.
# Deixe comentado para usar o default automático do provider escolhido
# acima (Claude para "anthropic", Llama/Qwen para "ollama"). Descomente
# para sobrescrever.
# JARVIS_MODEL_FAST=llama3.2:3b
# JARVIS_MODEL_DEFAULT=qwen2.5:7b-instruct
# JARVIS_MODEL_ADVANCED=qwen2.5:7b-instruct

# --- Segurança / Permissões ---
# Nível máximo de permissão concedido às ferramentas nesta instância (0-5).
# Ver docs/ARCHITECTURE.md, seção "Sistema de Segurança".
DEFAULT_PERMISSION_LEVEL=3
# Tempo (ms) que o agente aguarda confirmação do usuário para ações de nível >= 4
TOOL_CONFIRMATION_TIMEOUT_MS=60000
AUDIT_LOG_PATH=./data/audit.log

# --- Agente ---
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_NAME=JARVIS
USER_NAME=Usuário

# ──────────────────────────────────────────────────────────────
# As variáveis abaixo pertencem às Fases 2+ e ainda NÃO são lidas
# pelo código da Fase 1. Deixadas aqui para não quebrar o deploy
# quando essas fases forem implementadas.
# ──────────────────────────────────────────────────────────────

# --- Fase 2: Banco de dados ---
# DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
# REDIS_URL=redis://localhost:6379

# --- Fase 3: Voz ---
# ELEVENLABS_API_KEY=
# WAKE_WORD=jarvis
