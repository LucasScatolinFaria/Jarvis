# ──────────────────────────────────────────────────────────────
# JARVIS — Configuração de ambiente (Fase 1: Core + Chat)
# ──────────────────────────────────────────────────────────────

# --- Servidor ---
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Provedor de IA ---
# "ollama" = 100% grátis e local (padrão desta máquina: Ollama instalado,
#            llama3.2:3b + qwen2.5:7b-instruct já baixados).
LLM_PROVIDER=ollama

# Usado somente se LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OLLAMA_BASE_URL=http://localhost:11434

# Deixe comentado para usar os defaults do provider (llama3.2:3b /
# qwen2.5:7b-instruct). Descomente para sobrescrever.
# JARVIS_MODEL_FAST=llama3.2:3b
# JARVIS_MODEL_DEFAULT=qwen2.5:7b-instruct
# JARVIS_MODEL_ADVANCED=qwen2.5:7b-instruct

# --- Segurança / Permissões ---
# Nível máximo de permissão concedido às ferramentas nesta instância (0-5).
# Ver docs/ARCHITECTURE.md, seção "Sistema de Segurança".
DEFAULT_PERMISSION_LEVEL=3
# Tempo (ms) que o agente aguarda confirmação do usuário para ações de nível >= 4
TOOL_CONFIRMATION_TIMEOUT_MS=60000
AUDIT_LOG_PATH=./data/audit.log

# --- Agente ---
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_NAME=JARVIS
USER_NAME=Usuário

# ──────────────────────────────────────────────────────────────
# As variáveis abaixo pertencem às Fases 2+ e ainda NÃO são lidas
# pelo código da Fase 1. Deixadas aqui para não quebrar o deploy
# quando essas fases forem implementadas.
# ──────────────────────────────────────────────────────────────

# --- Fase 2: Banco de dados ---
# DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
# REDIS_URL=redis://localhost:6379

# --- Fase 3: Voz ---
# ELEVENLABS_API_KEY=
# WAKE_WORD=jarvis
